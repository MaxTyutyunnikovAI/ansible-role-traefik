{#-
    Logrotate for Traefik logs. Traefik reopens its log files on SIGUSR1,
    so postrotate signals the running process instead of restarting it —
    zero-downtime rotation. `copytruncate` is intentionally NOT used
    (it can lose lines between truncate and reopen); USR1-based reopen is
    the documented upstream approach.

    The PID is taken from systemd itself (`systemctl show -p MainPID`), which
    is authoritative — no fragile pidfile/pgrep matching needed.
-#}
# Ansible-managed file — do not edit on the host; change role variables instead.
{{ traefik_log_dir }}/*.log {
    su {{ traefik_system_user }} {{ traefik_system_group }}
    {{ traefik_logrotate_frequency }}
    rotate {{ traefik_logrotate_rotate }}
    maxsize {{ traefik_logrotate_maxsize }}
    missingok
    notifempty
    compress
    delaycompress
    dateext
    sharedscripts
    postrotate
        _pid="$(systemctl show --property=MainPID --value {{ traefik_service_name }} 2>/dev/null)"
        [ "${_pid}" != "0" ] && [ -n "${_pid}" ] && kill -USR1 "${_pid}" 2>/dev/null || true
    endscript
}
