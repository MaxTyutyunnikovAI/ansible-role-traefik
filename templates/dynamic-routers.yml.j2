# Dynamic configuration file generated by Ansible from a custom Jinja2 template.
# Feature: traefik_dynamic_configs_template (see defaults/main.yml).
# This example builds http.services / http.routers declaratively from the
# `traefik_generated_routers` inventory dict:
#
#   traefik_dynamic_configs_template: dynamic-routers.yml.j2
#   traefik_generated_routers:
#     app:
#       host: app.example.com
#       url: http://127.0.0.1:8080
#       middlewares: [security-headers, https-redirect]
http:
  services:
{% for name, svc in (traefik_generated_routers | default({})).items() %}
    {{ name }}:
      loadBalancer:
        servers:
          - url: "{{ svc.url }}"
{% endfor %}
  routers:
{% for name, rt in (traefik_generated_routers | default({})).items() %}
    {{ name }}:
      rule: "Host(`{{ rt.host }}`)"
      entryPoints:
        - websecure
      service: {{ name }}
      tls:
        certResolver: letsencrypt
{% if rt.middlewares is defined and rt.middlewares | length > 0 %}
      middlewares:
{% for mw in rt.middlewares %}
        - {{ mw }}
{% endfor %}
{% endif %}
{% endfor %}
