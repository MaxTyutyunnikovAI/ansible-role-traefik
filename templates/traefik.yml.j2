{#- Static Traefik v3 configuration. Declarative: the traefik_static_config
    dictionary is merged with computed blocks (certificatesResolvers from
    traefik_cert_resolvers / traefik_enable_acme, experimental.plugins from
    traefik_plugins, optional pilot block from traefik_pilot_enabled
    (v2-era path, unused on Traefik v3), kubernetes providers from
    traefik_kubernetes_*) and dumped via
    to_nice_yaml(indent=2), so overrides from inventory/group_vars behave
    predictably (dict merge/replace). -#}
{#- IMPORTANT about Jinja whitespace control in this template: Ansible's
    template environment does NOT enable trim_blocks/lstrip_blocks by default,
    so a statement tag placed on its own line still emits that line's newline
    into the output unless BOTH sides of the tag are stripped ("-...-%}").
    The previous revision of this file glued every inline tag to the END of
    the preceding text line; those stray newlines made the header comment
    lines and the first YAML key collapse onto ONE line ("do not edit by
    hand.accessLog:") and split the tail of the file into a SECOND YAML
    document. `traefik --check` reads only the FIRST document; when that
    pseudo-document contains nothing but comments it aborts the handler chain
    with: "no valid configuration found in file: /etc/traefik/traefik.yml".
    Rules for editing this template: every statement tag sits on its own line,
    starts at column 1 (no leading spaces — an indented "{% ... -%}" keeps the
    leading whitespace in the output) and ends with "-%}"; comment tags also
    start at column 1 and their body must never contain brace-hash sequences
    (the first closing marker ends the comment early and leaks raw text into
    the rendered YAML). The rendered file must contain exactly ONE YAML
    document — the static config mapping starting right after the two "# ..."
    header lines. -#}
{% set _resolvers = traefik_cert_resolvers if (traefik_cert_resolvers | length > 0) else (traefik_default_acme_resolver if (traefik_enable_acme | bool) else {}) -%}
{#- Resolver precedence: explicit traefik_cert_resolvers wins; otherwise the
    convenience switch traefik_enable_acme injects a default HTTP-01 resolver;
    otherwise no certificatesResolvers block is emitted at all. -#}
{% set _resolver_names = _resolvers.keys() | list -%}
{#- certResolver for the websecure entrypoint is ONLY added when a
    certificatesResolvers block exists and the user did NOT explicitly set
    a certResolver in their own static config (check respects overrides).
    Removes the historical dangling "certResolver: letsencrypt" when ACME
    is disabled (the resolver key still exists in defaults for back-compat,
    but the static template deletes it unless ACME is on). -#}
{% set _ws_tls_cr = _resolver_names[0] if (_resolver_names | length > 0) else '' -%}
{% set _existing_cr = traefik_static_config.get('entryPoints', {}).get('websecure', {}).get('http', {}).get('tls', {}).get('certResolver', '') -%}
{% set _ws_tls_extra = {'certResolver': _ws_tls_cr} if (_ws_tls_cr | length > 0 and _existing_cr | length == 0) else {} -%}
{% set _plugins_ns = namespace(d={}) -%}
{% for _p in traefik_plugins -%}
{% set _plugins_ns.d = _plugins_ns.d | combine({ _p.name: {'moduleName': _p.moduleName, 'version': _p.version} }) -%}
{% endfor -%}
{% set _plugins_dict = _plugins_ns.d -%}
{#- WHY namespace(): a plain `{% set %}` inside `{% for %}` lives in the loop
    iteration scope and is discarded when the iteration ends, so the naive
    accumulator silently rendered `experimental.plugins: {}` (verified with an
    in-memory render). Traefik's paerser (parser/nodes_metadata.go) rejects
    empty nodes whose type has no allowEmpty flag with exactly the startup
    error we saw: "plugins cannot be a standalone element (type
    map[string]plugins.Descriptor)". namespace() is the standard Jinja
    cross-loop mutation mechanism; `_plugins_dict` below is only used when
    non-empty (see the length guard at the experimental combine). -#}
{#- Observability blocks (prometheus/ping/serversTransport/hostResolver/tracing).
    Each is emitted only when its switch/dict is non-empty; they merge into the
    static config via combine() like resolvers/pilot do. `ping` is deliberately
    independent of the prometheus condition (upstream role had it nested — bug). -#}
{% set _prom_block = {
       'entryPoint': traefik_prometheus_entrypoint,
       'buckets': traefik_prometheus_buckets,
       'addEntryPointsLabels': traefik_prometheus_entrypoint_labels | bool,
       'addServicesLabels': traefik_prometheus_service_labels | bool,
       'addRoutersLabels': traefik_prometheus_router_labels | bool
     } | combine(traefik_prometheus_extra_props) -%}
{% set _metrics = {'prometheus': _prom_block} if (traefik_prometheus_enabled | bool) else {} -%}
{% set _ping = ({'entryPoint': traefik_ping_entrypoint} if (traefik_ping_entrypoint | length > 0) else {}) if (traefik_ping_enabled | bool) else none -%}
{% set _servers_transport = {traefik_servers_transport_name: traefik_servers_transport} if (traefik_servers_transport | length > 0) else {} -%}
{% set _tracing = ({'service': traefik_tracing_service,
                    'spanName': traefik_tracing_span_name,
                    '128bitTraceIDs': traefik_tracing_128bit_spans | bool}
                   | combine({'otlp': traefik_tracing_otlp} if (traefik_tracing_otlp | length > 0) else {})
                   | combine(traefik_tracing_extra))
                  if (traefik_tracing_enabled | bool) else {} -%}
{#- When Prometheus listens on a dedicated entrypoint that is not defined in
    traefik_static_config.entryPoints, add it automatically (:9090 by default
    is NOT implied — metrics share the named entrypoint address; we create a
    ":8082" metrics entrypoint only if the user did not define their own). -#}
{% set _ep_name = traefik_prometheus_entrypoint -%}
{% set _extra_ep = {} -%}
{% if (traefik_prometheus_enabled | bool) and (_ep_name not in (traefik_static_config.get('entryPoints', {}) | default({}, true))) -%}
{% set _extra_ep = {_ep_name: {'address': ':8082'}} -%}
{% endif -%}
{#- Plugins: every plugin used by a middleware MUST be declared under
    `experimental.plugins` — on Traefik v3 that declaration ALONE is enough:
    the daemon downloads the module from the plugin catalog (GitHub) at
    startup, no pilot/trial involved (pilot was removed in v3). The optional
    `pilot` block below (traefik_pilot_enabled + token) is a v2-era path kept
    for back-compat: it pre-fetches sources via `traefik trial --download`
    into traefik_plugins_dir so a catalog outage never blocks startup. -#}
{% set _pilot_block = {'token': traefik_pilot_token} | combine(traefik_pilot_extra_props) -%}
{#- Kubernetes providers: one shared connection block + per-provider extras
    (options are provider-specific — Traefik's strict parser rejects, say,
    kubernetesCRD keys inside kubernetesIngress). The providers merge below
    uses recursive=True so the file/docker providers already present in
    traefik_static_config survive. ingressClass is valid for kubernetesIngress
    and kubernetesCRD only; the Gateway provider selects GatewayClasses. -#}
{% set _k8s_conn = {}
       | combine({'endpoint': traefik_kubernetes_endpoint}
                 if (traefik_kubernetes_endpoint | length > 0) else {})
       | combine({'token': traefik_kubernetes_token}
                 if (traefik_kubernetes_token | length > 0) else {})
       | combine({'certAuthFilePath': traefik_kubernetes_cert_auth_file}
                 if (traefik_kubernetes_cert_auth_file | length > 0) else {}) -%}
{% set _k8s_class = {'ingressClass': traefik_kubernetes_ingress_class}
       if (traefik_kubernetes_ingress_class | length > 0) else {} -%}
{% set _k8s_providers = {}
       | combine({'kubernetesIngress': _k8s_conn
                                       | combine(_k8s_class)
                                       | combine(traefik_kubernetes_ingress_extra)}
                 if (traefik_kubernetes_enabled | bool
                     and traefik_kubernetes_ingress_enabled | bool) else {})
       | combine({'kubernetesCRD': _k8s_conn
                                   | combine(_k8s_class)
                                   | combine(traefik_kubernetes_crd_extra)}
                 if (traefik_kubernetes_enabled | bool
                     and traefik_kubernetes_crd_enabled | bool) else {})
       | combine({'kubernetesGateway': _k8s_conn
                                       | combine(traefik_kubernetes_gateway_extra)}
                 if (traefik_kubernetes_enabled | bool
                     and traefik_kubernetes_gateway_enabled | bool) else {}) -%}
{% set _static = traefik_static_config
                 | combine({'pilot': _pilot_block}
                           if (traefik_pilot_enabled | bool and traefik_pilot_token | length > 0) else {})
                 | combine({'experimental': {'plugins': _plugins_dict}}
                           if (_plugins_dict | length > 0) else {}, recursive=True)
                 | combine({'certificatesResolvers': _resolvers}
                           if (_resolvers | length > 0) else {})
                 | combine({'entryPoints': _extra_ep} if (_extra_ep | length > 0) else {}, recursive=True)
                  | combine({'entryPoints': {'websecure': {'http': {'tls': _ws_tls_extra}}}}, recursive=True)
                 | combine({'metrics': _metrics} if (_metrics | length > 0) else {})
                 | combine({'ping': _ping} if (_ping is not none) else {})
                 | combine({'serversTransport': _servers_transport} if (_servers_transport | length > 0) else {})
                 | combine({'hostResolver': traefik_hostresolver} if (traefik_hostresolver | length > 0) else {})
                 | combine({'tracing': _tracing} if (_tracing | length > 0) else {})
                 | combine({'providers': _k8s_providers} if (_k8s_providers | length > 0) else {}, recursive=True) -%}
# {{ ansible_managed }}
# Generated from the "traefik_static_config" dictionary — do not edit by hand.
{{ _static | to_nice_yaml(indent=2) }}
