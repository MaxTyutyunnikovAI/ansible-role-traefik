{#-
    Hardened systemd unit for Traefik v3.
    Mandatory security keys: NoNewPrivileges / ProtectSystem / ProtectHome /
    PrivateTmp. CAP_NET_BIND_SERVICE lets the unprivileged traefik user bind
    :80/:443. ReadWritePaths whitelists log & data dirs because ProtectSystem
    makes the rest of the filesystem read-only-ish for the service.
-#}
# {{ ansible_managed }}
[Unit]
Description=Traefik v3 - The Reverse Proxy At Scale
Documentation=https://doc.traefik.io/traefik/
After=network-online.target
Wants=network-online.target
# Do not let a crash-loop take the box down forever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User={{ traefik_system_user }}
Group={{ traefik_system_group }}

WorkingDirectory={{ traefik_data_dir }}
{% if traefik_envs | length > 0 %}
# Secrets (ACME DNS provider tokens etc.) live in a root-only 0600 file —
# `Environment=` lines would be world-readable here (unit mode 0644).
# systemd reads EnvironmentFile itself before dropping privileges.
EnvironmentFile=-{{ traefik_env_file }}
{% endif %}
ExecStart={{ traefik_bin_dir }}/traefik \
  --configFile={{ traefik_static_config_file }}

Restart=on-failure
RestartSec={{ traefik_restart_sec }}
TimeoutStartSec={{ traefik_start_timeout }}
LimitNOFILE={{ traefik_limit_nofile }}

# --- Security hardening -----------------------------------------------------
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native

# Bind :80/:443 as non-root without full root privileges
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
{% for cap in traefik_extra_capabilities %}
CapabilityBoundingSet={{ cap }}
AmbientCapabilities={{ cap }}
{% endfor %}

ReadWritePaths={{ traefik_log_dir }}
ReadWritePaths={{ traefik_data_dir }}
{% if traefik_pilot_enabled | bool %}
# The daemon writes downloaded Yaegi plugin sources into the trial cache dir
# at startup — ProtectSystem would otherwise make it read-only for the service.
ReadWritePaths={{ traefik_plugins_dir }}
{% endif %}

# Free-form extra [Service] keys from traefik_extra_unit_vars (dict -> "Key=Value").
# NB: unpacking `for key, value in dict2items` yields the LITERAL strings
# 'key'/'value' (a dict iterates its own keys) — hence item.key/item.value.
{% for item in traefik_extra_unit_vars | dict2items %}
{{ item.key }}={{ item.value }}
{% endfor %}

# RuntimeDirectory makes systemd create /run/<service> (owned by the service
# user) before ExecStart runs — without it the pgrep redirect in ExecStartPost
# fails with "cannot create /run/traefik/traefik.pid: Directory nonexistent".
# The pidfile below is consumed by the logrotate postrotate hook (see
# traefik-logrotate.j2) to send SIGUSR1 without restarting Traefik.
RuntimeDirectory={{ traefik_service_name }}
ExecStartPost=/bin/sh -c 'pgrep -f "{{ traefik_bin_dir }}/traefik" > /run/{{ traefik_service_name }}/{{ traefik_service_name }}.pid'
PIDFile=/run/{{ traefik_service_name }}/{{ traefik_service_name }}.pid

[Install]
WantedBy=multi-user.target
